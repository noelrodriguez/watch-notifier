# --- Watch Tracker ---
# NOTE: data/monitor_state.json and data/deals.json are intentionally NOT
# ignored — the GitHub Action commits them back each run to persist dedup
# memory and deal history across runs.

# Local run logs
*.log
monitor.log

# Local secrets sourced by run_now.sh (NTFY_TOPIC override, TELEGRAM_*)
.env

# Local setup helpers / progress (not used by the GitHub Actions version)
setup.command
setup.bat
.setup_progress

# VM migration runbook + session handover — local working notes, not shipped
VM_MIGRATION.md
HANDOVER.md

# Product planning workspace (ideas backlog + PRDs) — local working notes, not shipped
product/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# macOS
.DS_Store

# Superpowers brainstorm mockups
.superpowers/

# Claude Code: track shared skills under .claude/skills, ignore local-only bits
.claude/settings.local.json
.claude/worktrees/
.claude/launch.json
